{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "huntington-nd",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-10-14",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/contact", "/api/contact/*"],
    "not_found_handling": "404-page"
  }
}
